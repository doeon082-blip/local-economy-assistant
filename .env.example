# 한국은행 ECOS Open API 키 (없으면 샘플 키로 최대 10건 조회, 설정 시 최대 50,000건 자동 페이지네이션)
ECOS_API_KEY=

# 사용할 Ollama 채팅 모델
OLLAMA_MODEL=qwen3.5:4b

# Ollama 속도·메모리 튜닝 (기본 컨텍스트 4096, 모델 상주 시간 30분)
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=768
OLLAMA_KEEP_ALIVE=30m

# 대량 데이터 임베딩 배치 크기 및 병렬 워커 수
EMBED_BATCH_SIZE=128
EMBED_WORKERS=3

# Ollama 서버 주소 (로컬 기본값: http://127.0.0.1:11434)
OLLAMA_URL=http://127.0.0.1:11434

# 서버 / 컨테이너 배포 시에만 true로 설정
ALLOW_REMOTE_ACCESS=false
ALLOW_REMOTE_OLLAMA=false
HOST=127.0.0.1
PORT=8765

# 외부 공개 배포 시 ECOS 동기화를 보호할 관리자 키 (선택)
SYNC_ADMIN_KEY=

# 별도 프론트엔드 도메인 사용 시 쉼표로 구분해 지정
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 클라이언트(IP)당 분당 채팅·동기화 POST 허용 횟수 (0이면 제한 없음)
RATE_LIMIT_PER_MINUTE=60
